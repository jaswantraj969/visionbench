# Copy to .env and adjust. All variables use the VISIONBENCH_ prefix.
# Root directory for runtime data (datasets/, artifacts/, db/ are created on demand).
VISIONBENCH_DATA_ROOT=./var
# Maximum accepted upload size in megabytes (enforced by upload endpoints in a later milestone).
VISIONBENCH_MAX_UPLOAD_MB=200
# DEBUG | INFO | WARNING | ERROR | CRITICAL
VISIONBENCH_LOG_LEVEL=INFO

# --- Dataset ingestion / duplicates / splits (M1); CLI flags override these ---
# Images with more pixels than this are rejected as too_large_pixels.
VISIONBENCH_MAX_IMAGE_PIXELS=50000000
# Every class needs at least this many valid images.
VISIONBENCH_MIN_IMAGES_PER_CLASS=3
# Max Hamming distance between 64-bit dHashes to count as near duplicates.
VISIONBENCH_DHASH_THRESHOLD=5
# Images whose grayscale std (0-255 scale) is below this skip perceptual matching.
VISIONBENCH_LOW_INFO_STD_THRESHOLD=3.0
# Seeded sample size per class stored in report.json.
VISIONBENCH_REPORT_SAMPLES_PER_CLASS=8
# Label-conflict duplicate groups: exclude (default) or error.
VISIONBENCH_CONFLICT_POLICY=exclude
