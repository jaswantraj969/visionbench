# Copy to .env and adjust. All variables use the VISIONBENCH_ prefix.
# Root directory for runtime data (datasets/, artifacts/, db/ are created on demand).
VISIONBENCH_DATA_ROOT=./var
# Maximum accepted upload size in megabytes (enforced by upload endpoints in a later milestone).
VISIONBENCH_MAX_UPLOAD_MB=200
# DEBUG | INFO | WARNING | ERROR | CRITICAL
VISIONBENCH_LOG_LEVEL=INFO
