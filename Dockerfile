# VisionBench: API + worker + built frontend, CPU-only PyTorch.
#
#   docker compose up --build        (publishes 127.0.0.1:8000 only; data in the named volume)
#
# Stage 1 builds the frontend; stage 2 is python:3.11-slim with the locked CPU dependencies
# (requirements/lock-cpu-linux.txt, generated by scripts/lock_cpu_linux.sh in this base image).
# Base images are pinned by digest.

FROM node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements/lock-cpu-linux.txt requirements/
RUN python -m pip install -r requirements/lock-cpu-linux.txt \
      --extra-index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml README.md ./
COPY src/ src/
RUN python -m pip install --no-deps . && rm -rf build src/*.egg-info
COPY benchmarks/ benchmarks/
COPY --from=frontend /build/dist frontend/dist

# Non-root user; all runtime data lives in the volume.
RUN useradd --create-home --uid 10001 visionbench \
    && mkdir -p /data && chown visionbench:visionbench /data
USER visionbench
VOLUME ["/data"]
ENV VISIONBENCH_DATA_ROOT=/data \
    VISIONBENCH_BENCHMARKS_DIR=/app/benchmarks \
    VISIONBENCH_ROBUSTNESS_SUITES_DIR=/app/benchmarks \
    VISIONBENCH_FRONTEND_DIST=/app/frontend/dist \
    VISIONBENCH_CONTAINER=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"]
# --allow-non-loopback works only with VISIONBENCH_CONTAINER=1 (set above). The Host-header
# allow-list still applies, so publish the port to 127.0.0.1 on the host (see compose.yaml).
CMD ["visionbench", "serve", "--host", "0.0.0.0", "--port", "8000", "--allow-non-loopback"]
